# ---- Server ----
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ---- Database ----
# Local MongoDB:      mongodb://127.0.0.1:27017/taskflow_ai
# MongoDB Atlas:      mongodb+srv://<user>:<password>@<cluster>.mongodb.net/taskflow_ai
MONGO_URI=mongodb://127.0.0.1:27017/taskflow_ai

# ---- Auth ----
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# ---- AI (optional) ----
# Free key: https://aistudio.google.com/app/apikey
# If empty, TaskFlow uses its built-in heuristic AI engine (app still works fully).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
